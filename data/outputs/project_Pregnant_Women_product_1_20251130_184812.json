  "subtitle_sentences": [
    {
      "end_word": 6,
      "start_word": 0,
      "text": "﻿If you're pregnant and driving right now,",
      "word_count": 7
    },
    {
      "end_word": 13,
      "start_word": 7,
      "text": "there's a 73% chance you're putting your",
      "word_count": 7
    },
    {
      "end_word": 22,
      "start_word": 14,
      "text": "baby in danger and you don't even know it.",
      "word_count": 9
    },
    {
      "end_word": 31,
      "start_word": 23,
      "text": "I had no idea until my doctor told me—",
      "word_count": 9
    },
    {
      "end_word": 38,
      "start_word": 32,
      "text": "most pregnant women use their seatbelt wrong.",
      "word_count": 7
    },
    {
      "end_word": 53,
      "start_word": 39,
      "text": "The lap belt rides up on your belly instead of staying low on your hips.",
      "word_count": 15
    },
    {
      "end_word": 65,
      "start_word": 54,
      "text": "And when you brake hard or, God forbid, get in an accident,",
      "word_count": 12
    },
    {
      "end_word": 77,
      "start_word": 66,
      "text": "all that force goes straight into your bump. Directly onto your baby.",
      "word_count": 12
    },
    {
      "end_word": 86,
      "start_word": 78,
      "text": "This is exactly why Baby Gaurd Belt was created.",
      "word_count": 9
    },
    {
      "end_word": 92,
      "start_word": 87,
      "text": "It's not just another pregnancy gadget.",
      "word_count": 6
    },
    {
      "end_word": 103,
      "start_word": 93,
      "text": "It's a crash tested, certified solution that clips onto your seat",
      "word_count": 11
    },
    {
      "end_word": 111,
      "start_word": 104,
      "text": "and positions your seatbelt safely below your belly.",
      "word_count": 8
    },
    {
      "end_word": 116,
      "start_word": 112,
      "text": "Away from your vulnerable baby.",
      "word_count": 5
    },
    {
      "end_word": 126,
      "start_word": 117,
      "text": "The first time I drove with it, I literally cried.",
      "word_count": 10
    },
    {
      "end_word": 135,
      "start_word": 127,
      "text": "The belt finally stayed where it should be— automatically.",
      "word_count": 9
    },
    {
      "end_word": 143,
      "start_word": 136,
      "text": "No more pulling it down every five minutes.",
      "word_count": 8
    },
    {
      "end_word": 150,
      "start_word": 144,
      "text": "No more anxiety every time I brake.",
      "word_count": 7
    },
    {
      "end_word": 160,
      "start_word": 151,
      "text": "They even let you try it 30 days risk free,",
      "word_count": 10
    },
    {
      "end_word": 172,
      "start_word": 161,
      "text": "so get yours to experience real peace of mind on the road.",
      "word_count": 12
    }
  ],
